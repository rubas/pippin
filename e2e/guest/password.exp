# Sets a new password for the user that runs it, and for its login keychain.
# It reads the old and the new password from stdin, one per line, so that
# neither shows in an argument or a log. Run with `expect`.
log_user 0
set timeout 30
gets stdin old
gets stdin new

# The tools turn off the echo after they print the prompt, so a quick answer
# echoes back and the tool reads nothing. Wait a little before each answer.
proc answer {prompt value} {
  expect {
    $prompt { sleep 0.3; send -- "$value\r" }
    timeout { puts stderr "no prompt: $prompt"; exit 1 }
    eof { puts stderr "ended before the prompt: $prompt"; exit 1 }
  }
}

# sysadminctl exits with 0 also when the old password is wrong.
spawn sysadminctl -newPassword - -oldPassword -
answer "Old password:" $old
answer "New password:" $new
expect {
  "Incorrect password" { puts stderr "sysadminctl: the old password is wrong"; exit 1 }
  "Done" {}
  timeout { puts stderr "sysadminctl did not finish"; exit 1 }
}
expect eof

# sysadminctl leaves the login keychain at the old password.
spawn security set-keychain-password
answer "Old Password:" $old
answer "New Password:" $new
answer "Retype New Password:" $new
expect eof
if {[lindex [wait] 3] != 0} { puts stderr "security set-keychain-password failed"; exit 1 }
